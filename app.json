{
  "expo": {
    "name": "HomeLive",
    "slug": "HomeLive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "HomeLive necesita reconocimiento de voz para convertir tus comandos en texto.",
        "NSMicrophoneUsageDescription": "HomeLive necesita acceso al micrófono para escuchar comandos por voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.HomeLive"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "HomeLive necesita acceso al micrófono para registrar comandos por voz."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "HomeLive necesita acceso al micrófono para escuchar comandos por voz.",
          "speechRecognitionPermission": "HomeLive necesita reconocimiento de voz para convertir tus comandos en texto.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset"
    ]
  }
}
